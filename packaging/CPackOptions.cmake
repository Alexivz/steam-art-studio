set(CPACK_PACKAGE_NAME "steam-art-studio")
set(CPACK_PACKAGE_VENDOR "Steam Art Studio contributors")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Steam artwork studio with backups and an integrated workspace")
set(CPACK_PACKAGE_VERSION "${STUDIO_NUMERIC_VERSION}")
set(CPACK_PACKAGE_FILE_NAME "steam-art-studio-${STUDIO_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_CHECKSUM SHA256)
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
set(CPACK_PACKAGE_INSTALL_DIRECTORY "Steam Art Studio")
if(WIN32)
  # ZIP contains the EXE, Qt DLLs/platform/image plugins and notices, not user data.
  set(CPACK_GENERATOR ZIP)
else()
  set(CPACK_GENERATOR TGZ)
  set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
  set(CPACK_DEBIAN_PACKAGE_MAINTAINER "Steam Art Studio contributors")
  if(STUDIO_VERSION MATCHES "-")
    set(CPACK_DEBIAN_PACKAGE_VERSION "${STUDIO_NUMERIC_VERSION}~preview")
    set(CPACK_RPM_PACKAGE_RELEASE "0.preview.1")
  else()
    set(CPACK_DEBIAN_PACKAGE_VERSION "${STUDIO_NUMERIC_VERSION}")
    set(CPACK_RPM_PACKAGE_RELEASE "1")
  endif()
  set(CPACK_DEBIAN_PACKAGE_SECTION "games")
  set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
  set(CPACK_DEBIAN_PACKAGE_DEPENDS "qt6-image-formats-plugins, libqt6svg6")
  set(CPACK_DEBIAN_PACKAGE_RECOMMENDS "qt6-wayland")
  set(CPACK_RPM_PACKAGE_LICENSE "GPL-3.0-only")
  set(CPACK_RPM_PACKAGE_VERSION "${STUDIO_NUMERIC_VERSION}")
  set(CPACK_RPM_PACKAGE_REQUIRES "qt6-qtimageformats, qt6-qtsvg")
  set(CPACK_RPM_PACKAGE_AUTOREQPROV ON)
endif()
include(CPack)
