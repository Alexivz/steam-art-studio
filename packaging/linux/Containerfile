FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config python3 python3-venv git ca-certificates curl \
    qt6-base-dev libqt6svg6-dev qt6-image-formats-plugins libqt6opengl6-dev \
    libxkbcommon-x11-0 libxcb-cursor0 libfuse2 patchelf file desktop-file-utils \
    appstream-util dpkg-dev rpm squashfs-tools xz-utils nasm zlib1g-dev \
    libssl-dev libwebp-dev libgl1-mesa-dev libegl1-mesa-dev nsis qt6-wayland && apt-get clean
ENV QT_QPA_PLATFORM=offscreen
WORKDIR /work
