# A separate, matching native-host/MinGW Qt toolchain; no Linux Qt DLLs in Windows output.
FROM registry.fedoraproject.org/fedora:44
RUN dnf install -y cmake ninja-build python3 \
    mingw64-gcc-c++ mingw64-qt6-qtbase mingw64-qt6-qtsvg \
    mingw64-qt6-qtimageformats && dnf clean all
WORKDIR /work
