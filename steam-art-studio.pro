QT += core gui widgets network concurrent
linux: QT += dbus
win32-msvc: QMAKE_CXXFLAGS += /utf-8
win32: DEFINES += NOMINMAX WIN32_LEAN_AND_MEAN
CONFIG += c++17 warn_on
TEMPLATE = app
TARGET = steam-art-studio
INCLUDEPATH += src
SOURCES += src/main.cpp src/valvekv.cpp src/steam.cpp src/cache.cpp src/network.cpp src/transactions.cpp src/models.cpp src/preview.cpp src/window.cpp src/credentials.cpp
HEADERS += src/types.h src/valvekv.h src/steam.h src/cache.h src/network.h src/transactions.h src/models.h src/preview.h src/window.h src/credentials.h
DESTDIR = $$OUT_PWD/bin
OBJECTS_DIR = $$OUT_PWD/obj
MOC_DIR = $$OUT_PWD/moc
RCC_DIR = $$OUT_PWD/rcc
UI_DIR = $$OUT_PWD/ui
QMAKE_CXXFLAGS += -Wextra
RESOURCES += assets/resources.qrc
SOURCES += src/ui.cpp
HEADERS += src/ui.h
HEADERS += src/imageutils.h
SOURCES += src/libraryindex.cpp
HEADERS += src/libraryindex.h
SOURCES += src/draft.cpp
HEADERS += src/draft.h
SOURCES += src/transfers.cpp
HEADERS += src/transfers.h
HEADERS += src/diagnostics.h
SOURCES += src/animation.cpp
HEADERS += src/animation.h
SOURCES += src/workspace.cpp
HEADERS += src/platform.h
